# database:deploy 环境文件模板（无秘密）
#
# 复制到仓库之外的位置（例如 /etc/lithography/deploy.env 或工作区外临时目录），
# 填入真实值并限制为 0600。不要把填好的文件提交到 Git，也不要放进本模板目录。
#
# 本模板中的值均为占位符，不是可直接使用的配置。

DB_HOST=<数据库主机名或 IP>
DB_PORT=3306
DB_USER=<迁移专用账号；需要目标库 DDL/DML 权限>
DB_PASS=<迁移专用账号密码；从受控密钥系统注入>
DB_NAME=<目标数据库名；必须与 --database 参数完全一致>
DB_TIMEZONE=+08:00
# 必须为 false；迁移入口检测到 true 会直接拒绝
DB_SYNCHRONIZE=false

# 仅初始化管理员或开发账号时需要；只部署结构可删除以下两行。
# 从应用运行时实际使用的受控配置来源复用同一组值；全新环境也须让部署和应用使用同一组值。
# migration:verify 通过不能证明部署与应用的字段加密配置一致。
FIELD_ENCRYPTION_KEY=<与应用运行配置同源的16字符值>
FIELD_ENCRYPTION_IV=<与应用运行配置同源的16字符值>
