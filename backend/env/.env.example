# Environment template. Copy to env/.env.development, env/.env.e2e, or env/.env.production and fill real values.

# Runtime
# NODE_ENV controls runtime mode. production enables production env validation and prod defaults.
# APP_HOST/APP_PORT bind the API HTTP listener.
# APP_NAME is a deployment label required by production validation.
# DEBUG is reserved for tooling/framework output; backend log verbosity uses LOG_LEVEL.
NODE_ENV=
APP_NAME=
APP_HOST=
APP_PORT=
DEBUG=

# Logging
# LOG_LEVEL: debug | info | warn | error
# LOG_INCLUDE_REQUEST_META: production-only toggle for 4xx request metadata.
# Non-production always includes 4xx request metadata.
LOG_LEVEL=
LOG_INCLUDE_REQUEST_META=

# HTTP / CORS
# APP_CORS_ORIGINS is comma-separated. Empty means allow any origin when CORS is enabled.
# Production validation requires explicit origins when CORS is enabled.
APP_CORS_ENABLED=true
APP_CORS_ORIGINS=
APP_CORS_CREDENTIALS=true

# Request body
# APP_BODY_LIMIT bounds JSON/form request bodies (default "2mb").
# Validated format: bytes like "1kb", "2mb", "1gb". Uploads use separate multipart limits.
APP_BODY_LIMIT=

# GraphQL
# GRAPHQL_SANDBOX_ENABLED exposes the browser GraphQL sandbox.
# GRAPHQL_INTROSPECTION_ENABLED allows schema introspection.
GRAPHQL_SANDBOX_ENABLED=false
GRAPHQL_INTROSPECTION_ENABLED=false

# Database
# Prefer SSH tunnel or private network access. API and Worker may share the same DB config.
# DB_TIMEZONE is passed to TypeORM MySQL timezone handling.
# DB_POOL_SIZE is the MySQL connectionLimit.
# DB_SYNCHRONIZE=true lets TypeORM auto-sync Entity schema; forbidden in production.
# DB_LOGGING=true logs SQL statements.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
DB_TIMEZONE=+08:00
DB_POOL_SIZE=10
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis / BullMQ
# REDIS_DB is the Redis logical database index.
# REDIS_PASSWORD empty disables Redis AUTH.
# BULLMQ_PREFIX is the Redis key namespace for BullMQ queues/jobs.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=15
REDIS_PASSWORD=
REDIS_TLS=false
BULLMQ_PREFIX=bullmq

# Security
# FIELD_ENCRYPTION_* must be at least 16 characters.
# Keep FIELD_ENCRYPTION_* stable; changing them breaks existing encrypted field reads.
# JWT_*_EXPIRES_IN uses jsonwebtoken duration format, for example 1h or 7d.
# JWT_REFRESH_EXPIRES_IN is parsed config; current refresh tokens use JWT_EXPIRES_IN.
# JWT_ENABLE_REFRESH is parsed config; current login flow does not use it to gate refresh tokens.
# JWT_AUDIENCE is comma-separated and used for JWT verify/audience validation.
# PAGINATION_HMAC_SECRET signs cursor pagination tokens; changing it invalidates old cursors.
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_IV=
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256
JWT_ENABLE_REFRESH=true
JWT_ISSUER=ssts-local
JWT_AUDIENCE=DESKTOP,SSTSTEST,SSTSWEB,SSTSWEAPP,SJWEB,SJWEAPP
PAGINATION_HMAC_SECRET=

# Web session persistence (browser login keep-alive)
# Off by default: when disabled, /api/auth/web-session/* does not exist and the
# existing GraphQL login/authorization behavior is unchanged.
# Enabling it adds an HttpOnly, SameSite=Lax cookie scoped to
# /api/auth/web-session so a new tab can restore the SAME access token.
# WEB_SESSION_ACCESS_TOKEN_TTL is optional and only affects the web login token:
# leave it empty to keep the global JWT_EXPIRES_IN; set it (for example 8h) only
# as a separate, deliberate release decision. It never changes the global value
# and never affects weapp/third-party login or refresh token lifetime.
# WEB_SESSION_ALLOWED_ORIGINS is required when enabled; it is the explicit
# trusted frontend site list (for example http://localhost:5173 in development).
# WEB_SESSION_COOKIE_SECURE must be true in production (HTTPS required).
WEB_SESSION_ENABLED=false
WEB_SESSION_ACCESS_TOKEN_TTL=
WEB_SESSION_ALLOWED_ORIGINS=
WEB_SESSION_COOKIE_SECURE=false

# Worker entry guards
# Enables GraphQL queue enqueue/debug entrypoints; does not start/stop workers.
# AI queue entries also require STAFF/ADMIN. Email queue entry only checks this flag.
AI_QUEUE_DEBUG_ENABLED=false
EMAIL_QUEUE_DEBUG_ENABLED=false

# Capability runtime
# Loaded at process start. Restart API/Worker after file changes.
# CAPABILITY_DISABLED_IDS: comma-separated switchable capability ids configured as disabled.
CAPABILITY_DISABLED_IDS=

# Email delivery
# EMAIL_SEND_AS_USER runs sendmail through sudo -n -u <user> when non-empty.
# EMAIL_SENDMAIL_PATH is the sendmail binary path used by the worker.
EMAIL_SEND_AS_USER=no-reply-ssts
EMAIL_SENDMAIL_PATH=/usr/sbin/sendmail

# AI provider routing
# mock: force local mock provider.
# remote: use real provider only when the request explicitly selects one; otherwise keep local mock.
AI_PROVIDER_MODE=mock

# Qwen provider
# QWEN_GENERATE_MODEL is used by real AI E2E smoke requests, not as a backend default model.
# QWEN_AUTH_FAIL_API_KEY is used only by RUN_REAL_AI_AUTH_FAIL_E2E.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_GENERATE_MODEL=
QWEN_GENERATE_TIMEOUT_MS=30000
QWEN_AUTH_FAIL_API_KEY=

# OpenAI provider
# Model is supplied by request payload; this config only defines the remote endpoint/client.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_GENERATE_TIMEOUT_MS=30000

# RAG diagnosis client (POST <base>/v1/diagnose)
# Modes:
# - disabled (explicit): skip RAG-specific config checks and parameter parsing. Diagnosis
#   requests fail closed with CONFIG_ERROR and make no outbound call; residual URL/key/
#   timeout/switch values are ignored.
# - unset (default): keeps the remote default. Production allows both URL and key to be
#   unset, but configuring only one of them fails preflight.
# - remote (explicit): requires both LITHO_RAG_BASE_URL and LITHO_RAG_API_KEY.
# Other runtime-unusable configuration still fails closed in the client with CONFIG_ERROR.
# Consumers: task03 intake analysis and task05 engineer AI conversation. Task05 only switches
# its model entry to this client when mode=remote AND both URL/key are set; otherwise it keeps
# the legacy direct-provider path (mock mode always uses the dev fixture).
LITHO_RAG_MODE=disabled
LITHO_RAG_BASE_URL=
LITHO_RAG_API_KEY=
LITHO_RAG_TIMEOUT_MS=30000
# Only enable when the approved target is reachable over plain HTTP on a private network.
LITHO_RAG_ALLOW_TAILNET_HTTP=false

# Document export (maintenance report Word/PDF)
# PDF needs an embedded CJK font; leave both unset to probe the built-in candidates
# (Noto Sans CJK / Droid Sans Fallback). Set both when the font file is a TTC collection.
DOCUMENT_EXPORT_PDF_FONT_PATH=
DOCUMENT_EXPORT_PDF_FONT_FACE=

# Third-party auth / WeApp
# Used by WeApp third-party auth provider for code/session/phone/qrcode calls.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# E2E runner
# E2E_GROUP: core | worker | smoke. Empty defaults to core.
# E2E_SPECS: comma-separated *.e2e-spec.ts files; overrides selected group specs.
# E2E_NEEDS: comma-separated mysql,redis,bullmq,external; empty derives from group.
# E2E_SKIP_INFRA_CHECKS skips setup checks for declared needs.
# E2E_SKIP_DB_CLEANUP skips test DB cleanup in global setup.
# E2E_ALLOWED_DB_NAMES: comma-separated allowlist of database names the global full-DB
#   cleanup may target (default: lithography_e2e). This is a HARD guard: if the connected
#   DB is not in this list, cleanup aborts before any deletion, and no switch can bypass it.
#   Point .env.e2e at a dedicated, disposable E2E database (NOT the shared dev DB).
# E2E_ALLOW_DB_CLEANUP: must be 1 to actually run the full-DB TRUNCATE, as explicit consent
#   on top of the allowlist. The Migration record table is never truncated.
# RUN_REAL_AI_E2E enables real Qwen smoke and requires AI_PROVIDER_MODE=remote plus QWEN_*.
# RUN_REAL_AI_AUTH_FAIL_E2E enables real auth-failure smoke and requires QWEN_AUTH_FAIL_API_KEY.
# E2E_EMAIL_TO is the recipient for real email delivery smoke.
# WEAPP_QRCODE_SMOKE_AUDIENCE selects the WeApp qrcode smoke audience.
E2E_GROUP=
E2E_SPECS=
E2E_NEEDS=
E2E_SKIP_INFRA_CHECKS=false
E2E_SKIP_DB_CLEANUP=false
E2E_ALLOWED_DB_NAMES=lithography_e2e
E2E_ALLOW_DB_CLEANUP=1
RUN_REAL_AI_E2E=false
RUN_REAL_AI_AUTH_FAIL_E2E=false
E2E_EMAIL_TO=
WEAPP_QRCODE_SMOKE_AUDIENCE=SSTSWEAPP

# Migration drill
# Read by npm run migration:drill:empty-db.
# MIGRATION_DRILL_DOTENV overrides the dotenv file loaded by the drill script.
# MIGRATION_DRILL_DATABASE overrides DB_NAME as the target empty database.
# MIGRATION_DRILL_CREATE_TEMP_DB=true creates and drops a temporary drill database.
# MIGRATION_DRILL_ALLOW_NON_TEST_DB=true allows target DB names without test/drill/ci.
MIGRATION_DRILL_DOTENV=
MIGRATION_DRILL_DATABASE=
MIGRATION_DRILL_CREATE_TEMP_DB=false
MIGRATION_DRILL_ALLOW_NON_TEST_DB=false

# Development Mock Data seed controls.
# SEED_DOTENV overrides the default env/.env.e2e or env/.env.development lookup.
# Non-test database names require an explicit one-time opt-in.
# MOCK_SEED_PASSWORD is the shared login password for development-only Mock accounts.
SEED_DOTENV=
SEED_ALLOW_NON_TEST_DB=false
MOCK_SEED_PASSWORD=

# Admin "reset user password to default" service-side password (task 08.4).
# Only read on the server; never returned to clients or written to logs.
# Mandatory when the feature is used: missing/blank or policy-violating values make
# adminResetUserPasswordToDefault fail closed (no hard-coded fallback).
ADMIN_DEFAULT_RESET_PASSWORD=

# Reference document file storage (reference-document upload/download)
# REFERENCE_DOCUMENT_STORAGE_DIR is where uploaded files are stored on the server.
# Relative paths resolve against the backend working directory. Never point it
# into a directory tracked by Git; the default `var/reference-documents` is gitignored.
# REFERENCE_DOCUMENT_UPLOAD_MAX_BYTES caps a single upload in bytes (default 20 MiB).
# REFERENCE_DOCUMENT_ALLOWED_MIME_TYPES is a comma-separated allowlist; empty means
# the built-in default (pdf/word/excel/ppt/png/jpeg/text/markdown/csv).
# Note: it can only NARROW the built-in extension-to-MIME mapping; adding a MIME that
# no built-in extension maps to has no effect (requests with that extension are still 415).
REFERENCE_DOCUMENT_STORAGE_DIR=
REFERENCE_DOCUMENT_UPLOAD_MAX_BYTES=
REFERENCE_DOCUMENT_ALLOWED_MIME_TYPES=
# Task 09 local runtime: backup package storage and protection key.
# LOCAL_BACKUP_STORAGE_DIR must stay OUTSIDE the business original directory
# (REFERENCE_DOCUMENT_STORAGE_DIR): the protected cleanup only deletes packages,
# and mixing both roots would put business originals at risk. Default `var/local-backups`.
# LOCAL_BACKUP_PROTECTION_KEY is the package-level encryption key (hex/base64 string).
# It is never returned by any API, never written into a package, and never logged.
# When it is absent the packaging case fails closed (no usable package is produced);
# the service still boots, so a fresh checkout can run read-only status pages.
# LOCAL_BACKUP_PROTECTION_KEY_ID is recorded on each asset for key rotation.
LOCAL_BACKUP_STORAGE_DIR=
LOCAL_BACKUP_PROTECTION_KEY_ID=
LOCAL_BACKUP_PROTECTION_KEY=
# Task 09 S3.1/S4 cloud backup service (production adapter).
# LOCAL_BACKUP_CLOUD_BASE_URL is the cloud root that accepts backup packages and
# serves cloud package metadata/bytes. LOCAL_BACKUP_CLOUD_CREDENTIAL is the
# device/organization/purpose-scoped cloud credential (CLOUD_BACKUP purpose only:
# it must never be the business-sync credential).
# When either is absent the cloud ports are NOT registered: the backup stays
# PENDING (no fake receipt) and cloud package listing/download fails closed with
# "cloud service not connected". The credential is never returned by any API,
# never written into a package, and never logged.
LOCAL_BACKUP_CLOUD_BASE_URL=
LOCAL_BACKUP_CLOUD_CREDENTIAL=
LOCAL_BACKUP_CLOUD_TIMEOUT_MS=

# Upload size limits for the cloud backup chain (single file / whole package).
# A backup package is read into memory before it is sent as multipart, so an
# oversized package would exhaust the worker process. These limits are checked
# BEFORE the bytes are read: exceeding them fails closed with a controlled
# reason code instead of crashing the worker. Raise them if the site stores
# legitimately large originals.
LOCAL_BACKUP_CLOUD_MAX_UPLOAD_FILE_BYTES=
LOCAL_BACKUP_CLOUD_MAX_UPLOAD_PACKAGE_BYTES=

# Cloud business-sync endpoint (separate from the backup cloud service: two
# different purposes, two different credentials -- neither may stand in for the
# other). BUSINESS_SYNC_CLOUD_BASE_URL is the root that accepts business records
# from this device; BUSINESS_SYNC_CLOUD_CREDENTIAL is the credential for the
# BUSINESS_SYNC purpose only. When either is empty the business-sync receiver
# is NOT registered and the dispatch chain keeps tasks in "pending" state
# (resumable) instead of pretending success.
BUSINESS_SYNC_CLOUD_BASE_URL=
BUSINESS_SYNC_CLOUD_CREDENTIAL=
BUSINESS_SYNC_CLOUD_TIMEOUT_MS=
