# V13 开发 Mock 数据配置模板（无秘密，请复制到仓库外的受控目录再填写）
#
# 使用方式：
#   cp backend/scripts/mock-v13.env.example /secure/path/mock-v13.env
#   chmod 600 /secure/path/mock-v13.env
# 禁止提交本文件的实际填写副本到 Git；密码建议使用 MOCK_V13_PASSWORD_FILE 指向仓库外文件。
#
# 该文件只被 `npm run mock:v13` 显式读取（--env-file），不会自动加载 env/.env.development，
# 也不影响应用启动与正式部署。

# 必须是 development / test / e2e 等非 production 值。
NODE_ENV=development

# 专用 V13 开发库连接信息；库名必须同时出现在 --database、--confirm-database 与 --allow-database。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=<专用开发库账号>
DB_PASS=<专用开发库密码>
DB_NAME=<专用 V13 开发库名，例如 lithography_v13_dev>
# 必须与实际运行的开发后端使用相同时区；模板使用 +08:00，不要用 Z/UTC 代替。
# 预检会输出生效时区（不输出密钥）；已有数据库不要为跑 Mock 单独改时区。
DB_TIMEZONE=+08:00
DB_CHARSET=utf8mb4

# 必须与开发应用同源：用于 base_user_info.meta_digest 的 AES-CBC 字段加密。
# 必须使用同一份 FIELD_ENCRYPTION_KEY / FIELD_ENCRYPTION_IV，否则账号资料无法被应用读取。
FIELD_ENCRYPTION_KEY=<与开发应用一致的 16 位以上密钥>
FIELD_ENCRYPTION_IV=<与开发应用一致的 16 位以上 IV>

# 测试账号统一密码：二选一。
# 1) 推荐：指向仓库外文件的绝对路径，文件内容即密码（不要在命令行或日志中传递）。
MOCK_V13_PASSWORD_FILE=/secure/path/mock-v13-password.txt
# 2) 或直接写在仅本人可读的环境文件中（不推荐）。
# MOCK_V13_PASSWORD=<满足项目密码策略的测试密码>

# 仅 `--write` 时必需；缺少该短语会在写入前以退出码 2 拒绝。
MOCK_V13_WRITE_ACK=I_UNDERSTAND_MOCK_V13_WRITES_DEV_DB
